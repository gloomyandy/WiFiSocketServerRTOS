
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32C5_REV_MIN_0=y
# Use following if boot has debug enabled will also need alternate partiion table
#CONFIG_PARTITION_TABLE_OFFSET=0x10000
# Task watchdog: armed at runtime with main task as the only subscriber.
# Idle-task subscription is disabled so a healthy idle task cannot mask a wedged main.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# On the C5 we do no have enough RAM to run TLS connections with the default settings.
# The following reduce RAM usage, but result in a drop in normal http performance.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=20
CONFIG_ESP_WIFI_RX_BA_WIN=20
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=17280
CONFIG_LWIP_TCP_WND_DEFAULT=32767
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_IN_IRAM=n
CONFIG_SPI_MASTER_IN_IRAM=n
